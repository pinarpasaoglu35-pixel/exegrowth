# ── Supabase ─────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Admin key — smoke test only (creates/deletes the disposable test user).
# NEVER expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: where the smoke test sends requests (default http://localhost:3000)
# SMOKE_BASE_URL=http://localhost:3000

# ── Anthropic (AI) ───────────────────────────────────────
# https://platform.claude.com > API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Global default model (Sonnet: extraction/chat doesn't need Opus).
# Individual kernel prompts can override per call — e.g. a future
# AI_MODEL_SCORING=claude-opus-4-8 if evidence shows scoring needs it.
AI_MODEL=claude-sonnet-4-6
# Optional: stronger model for the baseline scoring pass only.
# AI_MODEL_SCORING=claude-opus-4-8

# ── App ──────────────────────────────────────────────────
# Used for magic-link redirects in production (Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
